{#
  Matrix HTML template.

  Supports rich HTML subset: <h1>-<h6>, <b>, <i>, <u>, <s>, <p>, <br>,
  <ul>, <ol>, <li>, <a href="">, <code>, <pre>, <blockquote>,
  <table>, <tr>, <td>, <th>, <hr>, <span>, <div>, etc.
#}
<h3>Changelog {{ platform }} - {{ date }}</h3>
{% if release_info_lines -%}
<p>{% for line in release_info_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
{% endif -%}
<p><b>List of merged PRs:</b></p>
<ul>
{% for pr in prs -%}
<li>{{ pr.linked }}</li>
{% endfor -%}
</ul>
<p><b>Download:</b></p>
{% if download_links_format == "inline" -%}
<p>{{ downloads | map(attribute="linked") | join(", ") }}</p>
{% else -%}
<ul>
{% for link in downloads -%}
<li>{{ link.linked }}</li>
{% endfor -%}
</ul>
{% endif -%}
